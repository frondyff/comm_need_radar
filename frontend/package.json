{
  "name": "community-radar-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:flyer": "node --test src/flyer/flyerMapState.test.js",
    "test:release-state": "node --test scripts/vercel-release-state.test.mjs",
    "test:prod:smoke": "node scripts/production-smoke.mjs critical",
    "test:prod:security": "node scripts/production-smoke.mjs security",
    "test:prod:e2e": "playwright test tests/production/production.spec.js tests/production/fallback.spec.js --project=chromium-desktop --project=chromium-mobile",
    "test:prod:nightly": "playwright test tests/production --grep-invert @visual",
    "test:prod:a11y": "playwright test tests/production/accessibility.spec.js",
    "test:prod:visual": "playwright test tests/production/visual.spec.js --project=chromium-desktop --project=chromium-mobile",
    "test:prod:lighthouse": "npx --yes @lhci/cli@0.15.1 autorun --config=lighthouserc.cjs",
    "test:prod:load": "k6 run tests/production/load.js",
    "preview": "vite preview",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "validate:boundaries": "node scripts/validate-boundaries.mjs",
    "validate:chatbot": "node scripts/validate-chatbot-client.mjs",
    "validate:dashboard-adapter": "node scripts/validate-dashboard-adapter.mjs",
    "validate:supabase-dashboard": "node scripts/validate-supabase-dashboard.mjs",
    "validate:supabase-contract": "node scripts/validate-supabase.mjs",
    "validate:supabase-analytics-writes": "node scripts/validate-analytics-writes.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.1",
    "html2canvas": "^1.4.1",
    "jspdf": "4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.383.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.3",
    "vite": "^5.1.0"
  }
}

    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
